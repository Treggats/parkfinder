{% extends 'base.html.twig' %}

{% block content %}
    <h1>Parks</h1>

    <ul>
        {% for park in paginator.items %}
            <li data-slug="{{ park.slug }}">
                <a href="{{ path('park_show', {slug: park.slug}) }}">{{ park.name }}</a>
            </li>
            {% else %}
            <li>No parks</li>
        {% endfor %}
    </ul>

    <p>{{ paginator.currentItemCount }} van {{ paginator.total }}</p>
    <p>Page: {{ paginator.page }} / {{ paginator.lastPage }}</p>
    {% if paginator.nextPage %}
        <p><a href="{{ path('park_index', {page: paginator.nextPage}) }}">Next</a></p>
    {% endif %}
    {% if paginator.previousPage %}
        <p><a href="{{ path('park_index', {page: paginator.previousPage}) }}">Previous</a></p>
    {% endif %}
{% endblock %}
